@inherits NotificationView<ActivateAccountModel>
@{
    var (Common, Local) = HtmlLocalizerFactory.GetLocalizers("notification-activate");
    string ctaBgSubtle = "#f8f9fa";
    string lightBorderSubtle = "#e9ecef";
    string darkBorderSubtle = "#adb5bd";
    string fontFamilyBase = $"{@SkinVariables.FontFamilySansSerif}, Arial, sans-serif";
    var channel = ContentContext.Channel;
    string channelBaseUrl= await GetChannelBaseUrlAsync();
}
    <mjml>
        <mj-head>
            <mj-title>Activate Account</mj-title>
            <mj-preview>Activate your new account</mj-preview>
            <mj-font name="@SkinVariables.FontFamilySansSerif" href="https://fonts.googleapis.com/css2?family=@SkinVariables.FontFamilySansSerif:ital,wght@@0,@SkinVariables.BaseFontWeight;0,@SkinVariables.ButtonFontWeight;0,@SkinVariables.HeadingsFontWeight;1,@SkinVariables.BaseFontWeight&amp;display=swap" />
            <mj-breakpoint width="460px" />
            <mj-attributes>
                <mj-text color="@SkinVariables.TextColour.ToHexString()" line-height="1.4" />
                <mj-button background-color="@SkinVariables.SecondaryColour.ToHexString()" border-radius="@SkinVariables.BorderRadius" font-size="20px" font-weight="@SkinVariables.ButtonFontWeight" width="100%" />
                <mj-section padding="16px 10%" />
                <mj-social-element padding="4px 8px" background-color="@SkinVariables.TextColour.ToHexString()" />
                <mj-kz-social-element padding="4px 8px" />
                <mj-all font-family="@fontFamilyBase" />
            </mj-attributes>
            <mj-style>
                @@media only screen and (min-width:660px) {
                    .body-wrap {
                        padding: 24px 0;
                    }
                }
                .box-shadow a {
                    display:block !important;
                    box-shadow: 0 3px 5px 0 rgba(0 0 0 / 33%);
                }
                a {
                    color: @SkinVariables.PrimaryColour.ToHexString();
                    text-decoration: underline;
                }
                a:hover {
                    text-decoration: none;
                }
            </mj-style>
        </mj-head>
        <mj-body width="660px" background-color="@SkinVariables.BackgroundColour.ToHexString()" css-class="body-wrap">
            <mj-wrapper border="4px solid @SkinVariables.PrimaryColour.ToHexString()" padding="0" background-color="#ffffff">
                <mj-section padding-top="42px">
                    <mj-column>
                        @await MjAssetImgAsync(channel.Organisation.LogoSlotName(), 188, 188, new { padding="0", alt = channel.Organisation.Name, width="94px" })
                    </mj-column>
                </mj-section>
                @* optional club photo starts *@
                <mj-section padding="0">
                    <mj-column>
                        @await MjAssetImgAsync("hero_slot", 1320, 784, new { padding="0", alt="Hero Photo", width="660px" })
                    </mj-column>
                </mj-section>
                @* optional club photo ends *@
                <mj-section>
                    <mj-column>
                        <mj-text  align="center"
                                  font-size="32px"
                                  font-weight="@SkinVariables.HeadingsFontWeight"
                        >
                            %=notification_greeting=%
                            @Model.Recipient.Name
                        </mj-text>

                        <mj-text align="center"
                                 font-size="16px"
                                 font-weight="@SkinVariables.ButtonFontWeight"
                        >
                            %=notification_activateaccount_openingparagraph=%
                        </mj-text>
                        <mj-text align="center"
                                 font-size="16px"
                                 font-weight="@SkinVariables.BaseFontWeight"
                        >
                            %=notification_activateaccount_maincontent2(block)=%
                        </mj-text>
                        <mj-button width="100%" padding-top="44px" href="@Model.ActivationUrl" css-class="box-shadow">
                            @await AssetImgAsync("test_user_slot", 42, 42, new { width="21", height="21", padding="0", alt="", style="display:inline-block;margin-right:4px;vertical-align:middle;" })
                            <span style="display: inline-block;vertical-align: middle">%=notification_activateaccount_button=%</span></mj-button>
                    </mj-column>
                </mj-section>

                <!-- Icons -->
                <mj-section padding="16px 0">
                    <mj-column>
                        <mj-social icon-size="40px" mode="horizontal" border-radius="0" container-background-color="#FFFFFF" >
                            <!-- we can customise the icons with src attribute -->
                            @await MjAssetSocialElementAsync("facebook-noshare", "%=web_footer_facebook_url(static)=%", "fb_icon_slot", 80, 80, new { alt="Facebook", padding="4px 8px", backgroundColor=SkinVariables.TextColour.ToHexString() })
                            @await MjAssetSocialElementAsync("x-noshare", "%=web_footer_twitter_url(static)=%", "x_icon_slot", 80, 80, new { alt="X", padding="4px 8px", backgroundColor=SkinVariables.TextColour.ToHexString() })
                            @await MjAssetSocialElementAsync("instagram", "%=web_footer_instagram_url(static)=%", "insta_icon_slot", 80, 80, new { alt="Instagram", padding="4px 8px", backgroundColor=SkinVariables.TextColour.ToHexString() })
                            @await MjAssetSocialElementAsync("youtube", "%=web_footer_youtube_url(static)=%", "yt_icon_slot", 80, 80, new { alt="YouTube", padding="4px 8px", backgroundColor=SkinVariables.TextColour.ToHexString() })
                        </mj-social>
                    </mj-column>
                </mj-section>

                <mj-section padding="16px 0">
                    <mj-column>
                        <mj-text align="center" font-size="18px" font-weight="@SkinVariables.BaseFontWeight">
                            <ul style="list-style:none;padding:0">
                                <li style="margin:8px 0;"><a href="#" style="color:@SkinVariables.TextColour.ToHexString(); text-decoration: none;">
                                    @await AssetImgAsync("phone_icon_slot", 42, 42, new { padding="0", alt="Phone", width="21px", height="21", style=$"display:inline-block;margin-right:4px;vertical-align:middle;background-color:{SkinVariables.TextColour.ToHexString()};width:21px;height:21px;" }) @channel.Organisation.TelephoneBoxOffice</a>
                                </li>
                                <li style="margin:8px 0;"><a href="#" style="color:@SkinVariables.TextColour.ToHexString(); text-decoration: none;">
                                    @await AssetImgAsync("email_icon_slot", 42, 42, new { padding="0", alt="Email", width="21px", height="21", style=$"display:inline-block;margin-right:4px;vertical-align:middle;background-color:{SkinVariables.TextColour.ToHexString()};width:21px;height:21px;" }) @channel.Organisation.BoxOfficeEmails.First()</a>
                                </li>
                            </ul>
                        </mj-text>
                    </mj-column>
                </mj-section>
                <mj-section padding="8px 5%">
                    <mj-column vertical-align="middle">
                        @await MjAssetImgAsync("partner_logo_slot_1", 240, 140, new { padding="8px", alt="", width="112px" })
                    </mj-column>
                    <mj-column vertical-align="middle">
                        @await MjAssetImgAsync("partner_logo_slot_2", 240, 140, new { padding="8px", alt="", width="112px" })
                    </mj-column>
                    <mj-column vertical-align="middle">
                        @await MjAssetImgAsync("partner_logo_slot_3", 240, 140, new { padding="8px", alt="", width="112px" })
                    </mj-column>
                </mj-section>
                <mj-section padding="16px 0">
                    <mj-column>
                        <mj-text align="center" font-size="16px" font-weight="400">
                            <a href="@channelBaseUrl/termsandconditions" target="_blank" style="color:@SkinVariables.TextColour.ToHexString(); text-decoration: none;white-space: nowrap;">Terms &amp; Conditions</a> <span style="padding: 0 8px">|</span> 
                            <a href="@channelBaseUrl/privacypolicy" target="_blank" style="color:@SkinVariables.TextColour.ToHexString();text-decoration:none;white-space: nowrap;">Privacy Policy</a>
                        </mj-text>
                    </mj-column>
                </mj-section>
            </mj-wrapper>
        </mj-body>
    </mjml>